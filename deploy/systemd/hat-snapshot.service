# The weekly snapshot release (docs/runbook.md, Snapshot and restore). Installed with
# scripts/install_snapshot_timer.sh, which fills in @REPO@, @DATA_ROOT@, @DATA_REPO@ and @PG_DUMP@.
[Unit]
Description=HAT weekly snapshot release
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
Environment="HAT_DATA_ROOT=@DATA_ROOT@"
Environment="HAT_DATA_REPO=@DATA_REPO@"
Environment=DB_NAME=hat_live
# the run stages one asset (up to 1.9 GB) at a time: on the root disk, not the data disk
Environment=HAT_SNAPSHOT_STAGE=/var/tmp
Environment="HAT_PG_DUMP=@PG_DUMP@"
ExecStart="@REPO@/scripts/hat_snapshot_weekly.sh"
Nice=10
MemoryMax=2G
TimeoutStartSec=6h
