# Example environment for Hire a Trader (HAT).
# Copy this file to .env and fill it in. .env is gitignored: keep real values out of git.

# ============================================
# Database (PostgreSQL only; HAT refuses any other database)
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=algotrading
DB_USER=postgres
DB_PASSWORD=your_password_here

# ============================================
# Fyers login (the daily token comes from the login dialog; see CLAUDE.md)
# ============================================
# The Fyers app credentials. The code also reads FYERS_APP_ID or FYERS_CLIENT_ID for CLIENT_ID,
# and FYERS_SECRET_KEY for SECRET_KEY.
CLIENT_ID=your_app_id_here
SECRET_KEY=your_secret_key_here
# The redirect URI registered with the Fyers app. The backend serves no callback route: after
# logging in at Fyers, copy the auth_code from the redirected URL into the login dialog.
REDIRECT_URI=http://localhost:3000/

# ============================================
# Server
# ============================================
# CORS allowed origins (comma-separated list of frontend URLs). Any http loopback origin is
# also allowed.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Frontend (frontend/.env): backend URL for a remote backend; leave unset in development, where
# the Vite dev server proxies /api to http://127.0.0.1:8000.
# VITE_API_URL=https://your-domain.com

# ============================================
# Hire a Trader (HAT) - off unless HAT_ENABLED is true
# ============================================
# HAT_ENABLED=true starts the scheduler and the live feed at startup. It needs PostgreSQL: on any
# other database the HAT runtime refuses to start.
HAT_ENABLED=false
# Tenant id for the single MVP user; empty uses the built-in default.
HAT_USER_ID=
# Where HAT writes Parquet, raw bhavcopy zips and backtests; empty uses data_system/hat/.
HAT_DATA_ROOT=
# Secrets: keep real values in .env outside version control (mode 0600), never here.
HAT_TELEGRAM_TOKEN=
HAT_TELEGRAM_CHAT_ID=
HAT_APPROVAL_SECRET=
HAT_MCP_BHAVCOPY_URL=
HAT_MCP_CMMARKET_URL=
