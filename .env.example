# Example Environment Configuration
# Copy this file to .env and fill in your credentials

# ============================================
# Database Configuration
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=algotrading
DB_USER=postgres
DB_PASSWORD=your_password_here

# Use SQLite for testing (1/true/yes/on, any case, uses SQLite instead of PostgreSQL)
USE_SQLITE_TEST=False

# Initialize database tables on import (set to False to skip auto-initialization)
INIT_DB_ON_IMPORT=True

# ============================================
# Fyers API Configuration
# ============================================
# Fyers broker credentials for live trading and real-time data
FYERS_APP_ID=your_app_id_here
FYERS_SECRET_KEY=your_secret_key_here
FYERS_ACCESS_TOKEN=your_access_token_here

# Alternative naming (legacy support)
CLIENT_ID=your_app_id_here
SECRET_KEY=your_secret_key_here
FYERS_CLIENT_ID=your_app_id_here

# Fyers OAuth redirect URI (for authentication flow)
REDIRECT_URI=http://localhost:3000/auth/callback

# ============================================
# WebSocket Configuration
# ============================================
# Frontend WebSocket URL override (frontend/.env). Leave unset in development:
# the Vite dev server proxies /api/websocket/stream to the backend.
# VITE_WS_URL=wss://your-domain.com/api/websocket/stream

# ============================================
# API Endpoint Configuration
# ============================================
# Backend API base URL (accessible from frontend)
# Leave unset for same-origin requests through the Vite proxy, or set a full URL for a remote backend.
# VITE_API_URL=https://your-domain.com

# ============================================
# OpenRouter API (Optional - for AI features)
# ============================================
OPENROUTER_API_KEY=your_openrouter_key_here

# ============================================
# Application Settings
# ============================================
PORT=8000
DEBUG=False
HAS_FYERS=False

# Environment mode (development, production)
ENVIRONMENT=development

# CORS allowed origins (comma-separated list of frontend URLs)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# Development mode (enables mock data and bypasses market hours checks)
DEV_MODE=False

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ============================================
# Security Configuration
# ============================================
# JWT secret key for authentication (change in production!)
JWT_SECRET_KEY=your-secret-key-change-in-production

# ============================================
# Risk Management Configuration
# ============================================
# Default price for risk calculations when market data unavailable
RISK_DEFAULT_PRICE=0

# Cache TTL in seconds (default: 3600 = 1 hour)
CACHE_TTL=3600

# ============================================
# Agentic Trader (LiteLLM)
# ============================================
# Providers: groq, openai, anthropic, cerebras
MODEL_PROVIDER=groq
LITELLM_MODEL=groq/llama-3.1-70b-versatile
GROQ_API_KEY=gsk_...
