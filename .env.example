# Example environment for Hire a Trader (HAT).
# Copy this file to .env and fill it in. .env is gitignored: keep real values out of git.

# ============================================
# Database (PostgreSQL only; HAT refuses any other database)
# ============================================
# deploy/hat/docker-compose.yml creates the database from DB_USER, DB_PASSWORD and DB_NAME and
# points the backend container at its own postgres service (DB_HOST is overridden there).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=algotrading
DB_USER=postgres
DB_PASSWORD=your_password_here
# The trading and runtime state lives in a second database on the same server, with the same
# credentials; the backend creates it at start when missing (docs/architecture.md, Storage).
DB_STATE_NAME=hat_state

# ============================================
# Fyers login (the daily token comes from the login dialog; see CLAUDE.md)
# ============================================
# The Fyers app credentials. The code also reads FYERS_APP_ID or FYERS_CLIENT_ID for CLIENT_ID,
# and FYERS_SECRET_KEY for SECRET_KEY.
CLIENT_ID=your_app_id_here
SECRET_KEY=your_secret_key_here
# The redirect URI registered with the Fyers app. The backend serves no callback route: after
# logging in at Fyers, copy the auth_code from the redirected URL into the login dialog.
REDIRECT_URI=http://localhost:3000/

# ============================================
# Order broker (docs/decisions.md: one active broker)
# ============================================
# The one broker HAT places orders with: fyers (default) or zerodha. An unknown name refuses the
# start. Market data always comes from Fyers, so Fyers logs in every day either way.
HAT_BROKER=fyers
# The Kite Connect app credentials, needed only with HAT_BROKER=zerodha (the start refuses
# without them). The backend serves no callback route: after logging in at Kite, copy the
# request_token from the redirected URL into the Zerodha login dialog.
KITE_API_KEY=
KITE_API_SECRET=
KITE_REDIRECT_URI=http://127.0.0.1:8000/api/hat/auth/zerodha/callback

# ============================================
# Server
# ============================================
# CORS allowed origins (comma-separated list of frontend URLs). Any http loopback origin is
# also allowed.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
# Level of the framework loggers (uvicorn, sqlalchemy); empty keeps the default.
FRAMEWORK_LOG_LEVEL=
# backend/start_server.py. Keep BACKEND_HOST on loopback outside Docker: there is no API auth.
# (The compose file sets 0.0.0.0 inside the container and publishes on 127.0.0.1 only.)
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_RELOAD=false
BACKEND_ACCESS_LOG=false
BACKEND_LOG_LEVEL=INFO

# Frontend dev and preview server: BACKEND_URL is the backend the /api proxy targets (default
# http://127.0.0.1:8000) and PORT the port it listens on (default 3000).
# BACKEND_URL=http://127.0.0.1:8000
# PORT=3000

# Frontend (frontend/.env): backend URL for a remote backend; leave unset in development, where
# the Vite dev server proxies /api to http://127.0.0.1:8000.
# VITE_API_URL=https://your-domain.com

# ============================================
# Hire a Trader (HAT) - off unless HAT_ENABLED is true
# ============================================
# HAT_ENABLED=true starts the scheduler and the live feed at startup. It needs PostgreSQL: on any
# other database the HAT runtime refuses to start.
HAT_ENABLED=false
# Tenant id for the single MVP user; empty uses the built-in default.
HAT_USER_ID=
# Where HAT writes Parquet, raw bhavcopy zips and backtests; empty uses data_system/hat/.
HAT_DATA_ROOT=
# The memory cap of each DuckDB connection over the data store; beyond it a query spills to disk.
HAT_DUCKDB_MEMORY=1GB
# The clone of the private data repo the daily update writes manifests and reference CSVs into
# (python -m app.hat.data.record); empty uses /data/workspace/algotradingdata.
HAT_DATA_REPO=
# The minute-history download (python -m app.hat.data.minute_history): the Fyers plan's daily
# requests, and those left to live trading out of the broker's day cap (default 5,000).
HAT_HISTORY_DAILY_LIMIT=5000
HAT_HISTORY_RESERVE=500
HAT_HISTORY_PER_MINUTE=50
# How far back the plan serves 1-minute candles, and the most days one request spans.
HAT_HISTORY_PLAN_DAYS=365
HAT_HISTORY_CHUNK_DAYS=100
# A day's 5-minute bars must fit the raw daily bar within this fraction, or the day is not stored.
HAT_HISTORY_ENVELOPE_TOL=0.005
# A symbol fails above this percent of rejected candles, or this many rejected in a row.
HAT_HISTORY_MAX_REJECT_PCT=0.5
HAT_HISTORY_MAX_REJECT_RUN=12
# Symbols written to bars_5m together (one rewrite of each day file per batch).
HAT_HISTORY_WRITE_BATCH=25
# Secrets: keep real values in .env outside version control (mode 0600), never here.
HAT_TELEGRAM_TOKEN=
HAT_TELEGRAM_CHAT_ID=
HAT_APPROVAL_SECRET=
HAT_MCP_BHAVCOPY_URL=
HAT_MCP_CMMARKET_URL=
# Seed a late subscriber's opening range and day low from the day high/low on its ticks. Off
# until the tick field names are checked against a recorded tick (HAT-DATA-114).
HAT_EXCHANGE_DAY_RANGE=false
# Seconds without a tick before a watched symbol is subscribed again and reported (HAT-DATA-116).
HAT_SYMBOL_SILENT_SECONDS=120
# Minutes an entry nothing of which filled may rest before it is cancelled (HAT-EXEC-046).
HAT_ENTRY_TIMEOUT_MINUTES=60

# ============================================
# Operations (docs/runbook.md): scripts/hat_backup.py
# ============================================
# The two backup targets: a local or external-disk directory and a second one on another device
# (a mounted cloud bucket, e.g. an rclone mount). Paths only; no bucket keys here.
HAT_BACKUP_LOCAL=
HAT_BACKUP_REMOTE=
