{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "check": "vp check",
    "fmt": "vp fmt",
    "lint": "vp lint",
    "type-check": "tsc --noEmit",
    "test": "vp test run",
