# Hire a Trader (HAT) - what stays out of git: market data, credentials, build output.

# ============================================
# Market data and databases (NEVER COMMIT)
# ============================================

# Data directories
data/
data_system/hat/

# HAT: Parquet bars, raw bhavcopy zips, backtest outputs (HAT_DATA_ROOT)
*.parquet
*.csv
*.db
*.sqlite
*.sqlite3
*.sql
*.dump

# HAT code and recorded fixtures live under paths the data rules above would hide
!backend/app/hat/data/
!scripts/data/
!backend/tests/hat/fixtures/*.csv

# Compressed archives
*.zip
*.tar
*.tar.gz
*.gz
*.rar
*.7z

# Research script output (scripts/research/): charts and tables
/reports/

# TLA+ model checking scratch (verification/tla/run.sh)
verification/tla/states/
verification/tla/.tlc.out

# ============================================
# Credentials and environment (NEVER COMMIT)
# ============================================

.env
.env.local
.env.*.local
*.env
!.env.example

secrets/
credentials/
*.key
*.pem
*.crt

# Fyers login token (fyers_tokens.FYERS_TOKEN_PATH) and its config
fyers/config/access_token.json
fyers/config/keys.env
fyers/config/refresh_token.json
# Kite (Zerodha) login token (kite_tokens.KITE_TOKEN_PATH)
kite/config/access_token.json

