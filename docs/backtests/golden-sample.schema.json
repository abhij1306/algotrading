{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "golden-sample/1",
  "title": "Golden sample (docs/backtests/golden-sample.md)",
  "type": "object",
  "required": ["format", "created", "created_by", "seed", "items"],
  "properties": {
    "format": {"const": "golden-sample/1"},
    "created": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "created_by": {"type": "string", "minLength": 1},
    "seed": {"type": "integer"},
    "data_audit_digest": {"type": ["string", "null"]},
    "rebased_from": {
      "type": "object",
      "required": ["file", "digest"],
      "properties": {"file": {"type": "string"}, "digest": {"type": "string"}}
    },
    "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/item"}},
    "mismatches": {
      "type": "array",
      "items": {
        "allOf": [{"$ref": "#/$defs/item"}],
        "required": ["store_value"],
        "properties": {"store_value": {"$ref": "#/$defs/value"}}
      }
    }
  },
  "$defs": {
    "value": {"type": ["number", "string", "boolean", "null"]},
    "item": {
      "type": "object",
      "required": ["id", "kind", "key", "value", "tolerance", "risk", "verified_from"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {
          "enum": [
            "bar_raw",
            "bar_adjusted",
            "corporate_action",
            "membership",
            "isin_lineage",
            "index_close",
            "feature",
            "breadth",
            "bar_5m_daily_agg"
          ]
        },
        "key": {"type": "object"},
        "value": {"$ref": "#/$defs/value"},
        "tolerance": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "required": ["abs"],
              "additionalProperties": false,
              "properties": {"abs": {"type": "number", "minimum": 0}}
            },
            {
              "type": "object",
              "required": ["rel"],
              "additionalProperties": false,
              "properties": {"rel": {"type": "number", "minimum": 0}}
            }
          ]
        },
        "risk": {"type": "string", "minLength": 1},
        "verified_from": {"type": "string", "minLength": 1},
        "rebase": {
          "type": "object",
          "required": ["reason", "previous_value", "from_file", "on"],
          "properties": {"reason": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
